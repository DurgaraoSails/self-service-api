FROM maven:3.9-eclipse-temurin-{{javaVersion}} AS build
WORKDIR /app
COPY . .
RUN {{buildCmd}} && \
    cp "$(ls target/*.jar | grep -v -- '-plain.jar' | head -n1)" /app/app.jar

FROM eclipse-temurin:{{javaVersion}}-jre
WORKDIR /app
RUN addgroup --system app && adduser --system --ingroup app app
COPY --from=build /app/app.jar app.jar
USER app
ENV PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "java -XX:MaxRAMPercentage=75 -jar app.jar{{runArgs}}"]
